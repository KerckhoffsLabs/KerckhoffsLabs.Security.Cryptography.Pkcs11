[submodule "vendor/pkcs11-mock"]
	path = vendor/pkcs11-mock
	url = https://github.com/Pkcs11Interop/pkcs11-mock.git
	ignore = untracked
[submodule "vendor/softhsmv2"]
	path = vendor/softhsmv2
	url = https://github.com/softhsm/SoftHSMv2
	ignore = untracked
[submodule "vendor/opencryptoki"]
	path = vendor/opencryptoki
	url = https://github.com/opencryptoki/opencryptoki
	ignore = untracked
[submodule "vendor/nss"]
	path = vendor/nss
	url = https://github.com/mozilla/nss.git
	shallow = true
	ignore = untracked
[submodule "vendor/kryoptic"]
	path = vendor/kryoptic
	url = https://github.com/latchset/kryoptic.git
	ignore = untracked
[submodule "vendor/pkcs11"]
	path = vendor/pkcs11
	url = https://github.com/oasis-tcs/pkcs11.git
	shallow = true
	ignore = untracked
[submodule "vendor/bouncyhsm"]
	path = vendor/bouncyhsm
	url = https://github.com/harrison314/BouncyHsm.git
	shallow = true
[submodule "vendor/craton-hsm-core"]
	path = vendor/craton-hsm-core
	url = https://github.com/craton-co/craton-hsm-core.git
	ignore = untracked
[submodule "vendor/freehsm"]
	path = vendor/freehsm
	url = https://github.com/afchine1337/freehsm.git
	ignore = untracked
[submodule "vendor/wolfssl"]
	path = vendor/wolfssl
	url = https://github.com/wolfSSL/wolfssl.git
	shallow = true
	ignore = untracked
[submodule "vendor/wolfpkcs11"]
	path = vendor/wolfpkcs11
	url = https://github.com/wolfSSL/wolfPKCS11.git
	ignore = untracked
