<Project>

  <PropertyGroup>
    <!-- Fix a warning or suppress it at the source with a justified #pragma / [SuppressMessage]. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Runs the .editorconfig IDExxxx rules during `dotnet build`; with TreatWarningsAsErrors,
         a `warning`-severity style rule fails the build. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Required for IDE0005 (unnecessary usings) to run at build time (dotnet/roslyn#41640).
         Projects without public XML docs (tests, the generator) suppress CS1591 in their csproj. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
