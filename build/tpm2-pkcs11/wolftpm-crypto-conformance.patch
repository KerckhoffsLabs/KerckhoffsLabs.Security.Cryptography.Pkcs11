                     rc = TPM_RC_FAILURE;
             }
 
+            /* r and s are padded with zeros to the curve size (TPM 2.0 Part 1
+             * Annex C.8), not returned at their minimal length */
+            if (rc == 0) {
+                int keySz = FwGetEccKeySize(
+                    obj->pub.parameters.eccDetail.curveID);
+                if (keySz <= 0 || keySz > (int)sizeof(rBuf) ||
+                        (int)rSz > keySz || (int)sSz > keySz) {
+                    rc = TPM_RC_FAILURE;
+                }
+                else {
+                    XMEMMOVE(rBuf + (keySz - rSz), rBuf, rSz);
+                    XMEMSET(rBuf, 0, keySz - rSz);
+                    rSz = (word32)keySz;
+                    XMEMMOVE(sBuf + (keySz - sSz), sBuf, sSz);
+                    XMEMSET(sBuf, 0, keySz - sSz);
+                    sSz = (word32)keySz;
+                }
+            }
+
             if (rc == 0) {
