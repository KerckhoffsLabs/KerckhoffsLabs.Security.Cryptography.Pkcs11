@@ -9023,7 +9023,8 @@ static TPM_RC FwCmd_RSA_Decrypt(FWTPM_CTX* ctx, TPM2_Packet* cmd,
     UINT32 keyHandle;
     FWTPM_DECLARE_VAR(cipherText, TPM2B_PUBLIC_KEY_RSA);
     UINT16 decScheme, decHashAlg;
-    UINT16 labelSize;
+    UINT16 labelSize = 0;
+    byte* label = NULL;
     FWTPM_Object* obj = NULL;
     FWTPM_DECLARE_VAR(rsaKey, RsaKey);
     int rsaKeyInit = 0;
@@ -9091,6 +9092,8 @@ static TPM_RC FwCmd_RSA_Decrypt(FWTPM_CTX* ctx, TPM2_Packet* cmd,
             rc = TPM_RC_COMMAND_SIZE;
         }
         else {
+            /* The OAEP label (Part 1 "OAEP"), hashed as given */
+            label = (labelSize > 0) ? &cmd->buf[cmd->pos] : NULL;
             cmd->pos += labelSize;
         }
 
@@ -9141,7 +9144,7 @@ static TPM_RC FwCmd_RSA_Decrypt(FWTPM_CTX* ctx, TPM2_Packet* cmd,
                 outBuf, (word32)FWTPM_MAX_PUB_BUF, rsaKey,
                 WC_RSA_OAEP_PAD, (enum wc_HashType)wcHashType,
                 FwGetMgfType(oaepHash),
-                NULL, 0);
+                label, labelSize);
         }
         else if (decScheme == TPM_ALG_NULL) {
             /* Raw RSA (no padding) */
@@ -14559,8 +14562,15 @@ static TPM_RC FwEncryptDecryptCore(FWTPM_CTX* ctx, TPM2_Packet* cmd,
         mode = obj->pub.parameters.symDetail.sym.mode.sym;
     }
     /* A non-NULL wire mode must match the key's configured mode; otherwise
-     * e.g. ECB could be applied to a CFB key (Part 3 Sec.12.6.1). */
-    else if (rc == 0 && mode != obj->pub.parameters.symDetail.sym.mode.sym) {
+     * e.g. ECB could be applied to a CFB key (Part 3 Sec.12.6.1). A key
+     * whose mode is NULL may be used with any mode. */
+    else if (rc == 0 &&
+            obj->pub.parameters.symDetail.sym.mode.sym != TPM_ALG_NULL &&
+            mode != obj->pub.parameters.symDetail.sym.mode.sym) {
+        rc = TPM_RC_MODE;
+    }
+    /* Neither the command nor the key names a mode */
+    if (rc == 0 && mode == TPM_ALG_NULL) {
         rc = TPM_RC_MODE;
     }
 
