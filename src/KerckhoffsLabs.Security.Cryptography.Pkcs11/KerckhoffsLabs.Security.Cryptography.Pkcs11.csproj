<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Single-target net10.0. CK_ULONG is NativeCULong (KerckhoffsLabs.Runtime.InteropServices),
      which since 1.2.0 ships its Windows (4-byte uint) build as a per-RID runtime asset: a plain
      net10.0 reference resolves the 4-byte build on 64-bit Windows and the nuint build everywhere
      else, automatically, with no Windows-specific target framework here. The guard in
      LowLevelPkcs11Library still verifies the resolved NativeCULong width matches the host, so an
      old or misresolved package fails loudly instead of silently mis-marshalling.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <RuntimeIdentifiers>win-x86;win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <LangVersion>13.0</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>KerckhoffsLabs.Security.Cryptography.Pkcs11</PackageId>
    <Version>0.0.0</Version>
    <Authors>KerckhoffsLabs and contributors</Authors>
    <Description>Modern, secure-by-default PKCS#11 v3.2 interop for .NET.</Description>
    <PackageTags>pkcs11;hsm;cryptography;pkcs11v3;pqc;ml-dsa;ml-kem</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Embedded package icon (PackageIconUrl is deprecated and not rendered by nuget.org).
         The file must be packed into the .nupkg — see the ItemGroup below. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://kerckhoffslabs.github.io/KerckhoffsLabs.Security.Cryptography.Pkcs11/</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/KerckhoffsLabs/KerckhoffsLabs.Security.Cryptography.Pkcs11</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- Single source of truth for the logo: the same 256x256 icon the docs site uses. Packed at the
         package root, which is what <PackageIcon> resolves against. Not compiled or copied to output
         (Visible=false keeps it out of the IDE's project tree). -->
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KerckhoffsLabs.Runtime.InteropServices" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\KerckhoffsLabs.Security.Cryptography.Pkcs11.Generators\KerckhoffsLabs.Security.Cryptography.Pkcs11.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      GlobalPropertiesToRemove="PublishAot" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KerckhoffsLabs.Security.Cryptography.Pkcs11.Tests" />
  </ItemGroup>

  <!--
    Ship the analyzer to consumers. The ProjectReference above runs it while building this library;
    packing it under analyzers/dotnet/cs is what makes KLPKCS11008 (RSA encryption without OAEP) fire
    in a consumer's build too — the weak primitives that are types get their compile-time signal from
    [Obsolete] + DiagnosticId, but a padding *value* has no symbol to mark.
  -->
  <Target Name="PackAnalyzer" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\KerckhoffsLabs.Security.Cryptography.Pkcs11.Generators\KerckhoffsLabs.Security.Cryptography.Pkcs11.Generators.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_AnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_AnalyzerAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
