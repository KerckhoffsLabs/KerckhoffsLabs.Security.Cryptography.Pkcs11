<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Single-target net10.0. CK_ULONG is NativeCULong (KerckhoffsLabs.Runtime.InteropServices),
      which since 1.2.0 ships its Windows (4-byte uint) build as a per-RID runtime asset: a plain
      net10.0 reference resolves the 4-byte build on 64-bit Windows and the nuint build everywhere
      else, automatically, with no Windows-specific target framework here. The guard in
      LowLevelPkcs11Library still verifies the resolved NativeCULong width matches the host, so an
      old or misresolved package fails loudly instead of silently mis-marshalling.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <RuntimeIdentifiers>win-x86;win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <LangVersion>13.0</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>KerckhoffsLabs.Security.Cryptography.Pkcs11</PackageId>
    <Version>0.0.0</Version>
    <Authors>KerckhoffsLabs and contributors</Authors>
    <Description>Modern, secure-by-default PKCS#11 v3.2 interop for .NET.</Description>
    <PackageTags>pkcs11;hsm;cryptography;pkcs11v3;pqc;ml-dsa;ml-kem</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://kerckhoffslabs.github.io/KerckhoffsLabs.Security.Cryptography.Pkcs11/</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/KerckhoffsLabs/KerckhoffsLabs.Security.Cryptography.Pkcs11</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KerckhoffsLabs.Runtime.InteropServices" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
    <!--
      Every public member must be declared in PublicAPI.*.txt, so a surface change is a reviewable
      diff. Until 1.0.0 ships, the whole surface lives in PublicAPI.Unshipped.txt.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The analyzers, run on this library's own code too; PackAnalyzer below ships them. -->
    <ProjectReference
      Include="..\KerckhoffsLabs.Security.Cryptography.Pkcs11.SecurityAnalyzers\KerckhoffsLabs.Security.Cryptography.Pkcs11.SecurityAnalyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      GlobalPropertiesToRemove="PublishAot" />
    <!-- The source generators this library builds itself with (the Windows-packed struct siblings). Build
         time only: never packed, so consumers' builds do not load them. -->
    <ProjectReference
      Include="..\KerckhoffsLabs.Security.Cryptography.Pkcs11.SourceGenerators\KerckhoffsLabs.Security.Cryptography.Pkcs11.SourceGenerators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      GlobalPropertiesToRemove="PublishAot" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KerckhoffsLabs.Security.Cryptography.Pkcs11.Tests" />
  </ItemGroup>

  <!--
    Ship the security analyzers (KLPKCS11008-KLPKCS11010) to consumers. The SecurityAnalyzers
    ProjectReference above runs them while building this library; packing them under
    analyzers/dotnet/cs is what makes them fire in a consumer's build too. The weak primitives that
    are types get their compile-time signal from [Obsolete] + DiagnosticId, but a padding or mechanism
    *value* has no symbol to mark. The SourceGenerators project is deliberately not packed.
  -->
  <Target Name="PackAnalyzer" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\KerckhoffsLabs.Security.Cryptography.Pkcs11.SecurityAnalyzers\KerckhoffsLabs.Security.Cryptography.Pkcs11.SecurityAnalyzers.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_AnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_AnalyzerAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
