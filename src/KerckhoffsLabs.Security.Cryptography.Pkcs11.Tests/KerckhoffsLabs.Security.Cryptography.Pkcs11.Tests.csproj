<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <LangVersion>13.0</LangVersion>
    <!--
      GenerateDocumentationFile is on repo-wide (Directory.Build.props) only so IDE0005
      (unused usings) runs at build. Individual test methods are not XML-documented, so the
      missing-doc warning (CS1591) is suppressed; every other doc-comment diagnostic
      (unresolved/malformed crefs, param mismatches, malformed XML) is fixed at the source.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KerckhoffsLabs.Security.Cryptography.Pkcs11\KerckhoffsLabs.Security.Cryptography.Pkcs11.csproj" />
    <!--
      Run the shipped analyzer against the tests, exactly as a consumer's build would: the tests are
      the closest thing we have to real consumer code, so the insecure-RSA-padding diagnostic
      (KLPKCS11008) is proven to fire — and to be suppressible per-site — end to end.
    -->
    <ProjectReference
      Include="..\KerckhoffsLabs.Security.Cryptography.Pkcs11.Generators\KerckhoffsLabs.Security.Cryptography.Pkcs11.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.DotNet.XUnitExtensions" Version="11.0.0-beta.25605.110" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <Target Name="BuildPkcs11Mock" BeforeTargets="PrepareForBuild" Condition="'$(SkipPkcs11MockBuild)' != 'true'">
    <PropertyGroup>
      <_MockOutputDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)</_MockOutputDir>
      <!-- The mock must match the architecture the tests run as (the testhost = the .NET SDK arch),
           not the architecture of the (64-bit) pwsh that runs the build script. An explicit RID
           build (-r) wins; otherwise use the SDK's RID. -->
      <_MockRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_MockRid>
      <_MockRid Condition="'$(_MockRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_MockRid>
    </PropertyGroup>
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="bash &quot;$(MSBuildProjectDirectory)/../../build/build-pkcs11-mock.sh&quot; &quot;$(_MockOutputDir)&quot;" IgnoreStandardErrorWarningFormat="true" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))" Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build\build-pkcs11-mock.ps1&quot; -TestOutputDir &quot;$(_MockOutputDir)&quot; -Rid &quot;$(_MockRid)&quot;" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <!-- Spec-version gate shims (Linux/macOS only): tiny C wrappers that restrict which
       PKCS#11 API version a consumer can negotiate against a real backend. Used by the
       SoftHsmGate* fixtures to validate v2.40 / v3.0 compatibility end to end. -->
  <Target Name="BuildPkcs11Gate" BeforeTargets="PrepareForBuild" Condition="'$(SkipPkcs11GateBuild)' != 'true' AND !$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <_GateOutputDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)</_GateOutputDir>
    </PropertyGroup>
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/build-pkcs11-gate.sh&quot; &quot;$(_GateOutputDir)&quot;" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <Target Name="BuildSoftHsmV2" BeforeTargets="PrepareForBuild" Condition="'$(SkipSoftHsmV2Build)' != 'true'">
    <PropertyGroup>
      <_SoftHsmOutputDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)</_SoftHsmOutputDir>
      <!-- Build libsofthsm2 for the architecture the tests run as (the testhost = the .NET SDK arch),
           not the (64-bit) pwsh running the script. An explicit RID build (-r) wins; else the SDK's RID. -->
      <_SoftHsmRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_SoftHsmRid>
      <_SoftHsmRid Condition="'$(_SoftHsmRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_SoftHsmRid>
    </PropertyGroup>
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="bash &quot;$(MSBuildProjectDirectory)/../../build/build-softhsmv2.sh&quot; &quot;$(_SoftHsmOutputDir)&quot;" IgnoreStandardErrorWarningFormat="true" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))" Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build\build-softhsmv2.ps1&quot; -TestOutputDir &quot;$(_SoftHsmOutputDir)&quot; -Rid &quot;$(_SoftHsmRid)&quot;" IgnoreStandardErrorWarningFormat="true" />
  </Target>

</Project>
