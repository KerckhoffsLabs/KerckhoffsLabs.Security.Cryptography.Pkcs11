<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <LangVersion>13.0</LangVersion>
    <!-- Match the namespace used by the moved adapter tests; keep test files in the
         flat .Adapters.Tests namespace. -->
    <RootNamespace>KerckhoffsLabs.Security.Cryptography.Pkcs11.Adapters.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KerckhoffsLabs.Security.Cryptography.Pkcs11\KerckhoffsLabs.Security.Cryptography.Pkcs11.csproj" />
    <ProjectReference Include="..\KerckhoffsLabs.Security.Cryptography.Pkcs11.Adapters\KerckhoffsLabs.Security.Cryptography.Pkcs11.Adapters.csproj" />
    <!-- Reuses the shared test infrastructure (SoftHsmBackendFixture, MockBackendFixture,
         TestKeys, Settings, IPkcs11Backend) from the main Tests assembly. xUnit
         [CollectionDefinition]s are per-assembly, so SoftHsmBackendCollection / MockBackendCollection
         are redeclared locally in Collections.cs. -->
    <ProjectReference Include="..\KerckhoffsLabs.Security.Cryptography.Pkcs11.Tests\KerckhoffsLabs.Security.Cryptography.Pkcs11.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.DotNet.XUnitExtensions" Version="11.0.0-beta.25605.110" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- SoftHSM/mock native libs live under bin/<conf>/<tfm>/runtimes/<rid>/native/ in the main
       Tests assembly. Adapters.Tests can't run those build scripts itself: the SoftHSM autotools
       build dir is in vendor/ and is not serialised between two MSBuild projects on a clean CI
       build, so concurrent invocations race. Instead, copy the artifacts Tests already built.
       The ProjectReference to .Tests above guarantees Tests is fully built first, so by the time
       this target runs the runtimes/ tree is already populated. -->
  <Target Name="CopyNativeArtifactsFromTests" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_TestsBinDir>$(MSBuildProjectDirectory)/../KerckhoffsLabs.Security.Cryptography.Pkcs11.Tests/bin/$(Configuration)/$(TargetFramework)</_TestsBinDir>
      <_AdaptersTestsBinDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)</_AdaptersTestsBinDir>
    </PropertyGroup>
    <ItemGroup>
      <_NativeArtifact Include="$(_TestsBinDir)/runtimes/**/*" Exclude="$(_TestsBinDir)/runtimes/**/tokens/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeArtifact)" DestinationFiles="@(_NativeArtifact->'$(_AdaptersTestsBinDir)/runtimes/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_NativeArtifact)' != ''" />
  </Target>

</Project>
