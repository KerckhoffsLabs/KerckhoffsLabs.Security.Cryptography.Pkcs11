<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <LangVersion>13.0</LangVersion>
    <!-- Match the namespace used by the moved adapter tests; keep test files in the
         flat .Adapters.Tests namespace. -->
    <RootNamespace>KerckhoffsLabs.Security.Cryptography.Pkcs11.Adapters.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KerckhoffsLabs.Security.Cryptography.Pkcs11\KerckhoffsLabs.Security.Cryptography.Pkcs11.csproj" />
    <ProjectReference Include="..\KerckhoffsLabs.Security.Cryptography.Pkcs11.Adapters\KerckhoffsLabs.Security.Cryptography.Pkcs11.Adapters.csproj" />
    <!-- Reuses the shared test infrastructure (SoftHsmBackendFixture, MockBackendFixture,
         TestKeys, Settings, IPkcs11Backend) from the main Tests assembly. xUnit
         [CollectionDefinition]s are per-assembly, so SoftHsmBackendCollection / MockBackendCollection
         are redeclared locally in Collections.cs. -->
    <ProjectReference Include="..\KerckhoffsLabs.Security.Cryptography.Pkcs11.Tests\KerckhoffsLabs.Security.Cryptography.Pkcs11.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.DotNet.XUnitExtensions" Version="11.0.0-beta.25605.110" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- SoftHSM/mock native libs (and the fixture-managed runtimes/<rid>/native/tokens dir) must
       live in THIS assembly's bin/ for the xUnit fixture to resolve and initialise them. Each
       project runs the same build scripts — they're cache-aware ("up to date" on re-entry) — and
       the ProjectReference to .Tests above serialises the two projects so the second invocation
       is a no-op rather than a race. Can be deduplicated to a shared .targets if maintenance
       becomes an issue. -->
  <Target Name="BuildPkcs11Mock" BeforeTargets="PrepareForBuild" Condition="'$(SkipPkcs11MockBuild)' != 'true'">
    <PropertyGroup>
      <_MockOutputDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)</_MockOutputDir>
      <_MockRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_MockRid>
      <_MockRid Condition="'$(_MockRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</_MockRid>
    </PropertyGroup>
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="bash &quot;$(MSBuildProjectDirectory)/../../build/build-pkcs11-mock.sh&quot; &quot;$(_MockOutputDir)&quot;" IgnoreStandardErrorWarningFormat="true" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))" Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build\build-pkcs11-mock.ps1&quot; -TestOutputDir &quot;$(_MockOutputDir)&quot; -Rid &quot;$(_MockRid)&quot;" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <Target Name="BuildSoftHsmV2" BeforeTargets="PrepareForBuild" Condition="'$(SkipSoftHsmV2Build)' != 'true'">
    <PropertyGroup>
      <_SoftHsmOutputDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)</_SoftHsmOutputDir>
    </PropertyGroup>
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="bash &quot;$(MSBuildProjectDirectory)/../../build/build-softhsmv2.sh&quot; &quot;$(_SoftHsmOutputDir)&quot;" IgnoreStandardErrorWarningFormat="true" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))" Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build\build-softhsmv2.ps1&quot; -TestOutputDir &quot;$(_SoftHsmOutputDir)&quot;" IgnoreStandardErrorWarningFormat="true" />
  </Target>

</Project>
