<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;IsAotCompatible">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Roslyn analyzers target netstandard2.0, which does not support AOT publish.
         TreatAsLocalProperty overrides any global PublishAot=true propagated by a
         consuming project so that the SDK's ProcessFrameworkReferences task does not
         emit NETSDK1207 when the smoke project (or any AOT-publish consumer) is built. -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <!-- GenerateDocumentationFile is on repo-wide (for IDE0005). Generator types aren't
         individually XML-documented (CS1591); other doc-comment diagnostics are fixed at the source. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- CSharp is capped below Analyzers' latest: CS9057 rejects an analyzer assembly that
         references a newer compiler AssemblyVersion than the one actually running the build.
         The .NET 10 SDK's bundled compiler currently reports AssemblyVersion 5.0.0.0, so
         Microsoft.CodeAnalysis.CSharp 5.3.0+ (AssemblyVersion 5.3.0.0+) fails CS9057 on every
         consumer, not just docfx's own metadata step — raise this only once the SDK's bundled
         compiler catches up. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
