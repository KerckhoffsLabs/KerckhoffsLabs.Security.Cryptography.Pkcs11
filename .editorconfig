# EditorConfig — https://editorconfig.org
# Root of the repository.
root = true

# ---------------------------------------------------------------------------
# All files — whitespace conventions enforced by `dotnet format`.
# ---------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,ps1}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false

# Generated code — skip code-style/naming analysis (these files are not hand-edited).
[*.{g,g.i,Designer}.cs]
generated_code = true

# ---------------------------------------------------------------------------
# C# source.
#
# Severity policy:
#   :warning  — enforced. With <EnforceCodeStyleInBuild> + <TreatWarningsAsErrors>
#               (Directory.Build.props) these fail the build and the CI lint.
#   :suggestion — advisory (IDE hint only); used for shape preferences that would
#               otherwise cause churn-only reformatting.
#   :silent   — documented but never surfaced (e.g. `var`, intentionally mixed here).
# ---------------------------------------------------------------------------
[*.cs]
indent_size = 4
max_line_length = 120   # informational only — not enforced by build or `dotnet format`.

# Unused usings are not allowed.
dotnet_diagnostic.IDE0005.severity = warning

# `this.`/`Me.` qualification — prefer unqualified.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Language keywords over BCL type names (int over Int32).
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# Modifiers and readonly.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning

# Expression-level preferences.
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
# Advisory, not enforced: this codebase has byte[]/ReadOnlySpan<byte> overload pairs, and the
# fixer rewrites e.g. `ReadOnlySpan<byte>.Empty` to `[]`, which is then ambiguous (CS0121).
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning

# `var` usage is intentionally mixed in this codebase — documented but not surfaced.
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent

# Expression-bodied members: shape preference, left advisory to avoid churn-only rewrites.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion

# Pattern matching and modern syntax.
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_style_throw_expression = true:warning
csharp_prefer_simple_using_statement = true:warning

# File-scoped namespaces are used throughout.
csharp_style_namespace_declarations = file_scoped:warning

# `using` directives sit outside the namespace.
csharp_using_directive_placement = outside_namespace:warning

# ---------------------------------------------------------------------------
# Naming conventions (advisory — documents the conventions the code follows).
# ---------------------------------------------------------------------------

# Interfaces are PascalCase with an `I` prefix.
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = begins_with_i
dotnet_naming_rule.interfaces_start_with_i.severity = suggestion
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# Type parameters are PascalCase with a `T` prefix.
dotnet_naming_rule.type_parameters_start_with_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_start_with_t.style = begins_with_t
dotnet_naming_rule.type_parameters_start_with_t.severity = suggestion
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_style.begins_with_t.required_prefix = T
dotnet_naming_style.begins_with_t.capitalization = pascal_case

# Constants are PascalCase.
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case_style
dotnet_naming_rule.constants_are_pascal_case.severity = suggestion
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Private instance fields are _camelCase.
dotnet_naming_rule.private_fields_should_be_camel_case_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case_with_underscore.style = camel_case_underscore_style
dotnet_naming_rule.private_fields_should_be_camel_case_with_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_underscore_style.required_prefix = _
dotnet_naming_style.camel_case_underscore_style.capitalization = camel_case
